---
const { tipPosition = 'top', tipContent } = Astro.props;
---

<div class="tooltip-wrapper" tip-position={tipPosition}>
  <slot />
  <div class="tooltip">{tipContent}</div>
</div>

<style>
  .tooltip-wrapper {
    position: relative;
    display: inline-block;
  }

  .tooltip {
    position: absolute;
    background-color: #333;
    color: #fff;
    padding: 8px;
    border-radius: 4px;
    font-size: 14px;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1000;
  }

  .tooltip-wrapper:hover .tooltip {
    visibility: visible;
    opacity: 1;
  }

  /* Anchor positioning based on tipPosition */
  .tooltip-wrapper[tip-position="top"] .tooltip {
    position: anchor(target top);
    inset-block-end: 8px;
  }

  .tooltip-wrapper[tip-position="bottom"] .tooltip {
    position: anchor(target bottom);
    inset-block-start: 8px;
  }

  .tooltip-wrapper[tip-position="left"] .tooltip {
    position: anchor(target left);
    inset-inline-end: 8px;
  }

  .tooltip-wrapper[tip-position="right"] .tooltip {
    position: anchor(target right);
    inset-inline-start: 8px;
  }
</style>
